{
  "name": "clinica-ai-whatsapp",
  "version": "1.0.0",
  "description": "Sistema de Atendimento e Agendamento Automatico via WhatsApp para Clinicas com Multiagentes de IA",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/src/server.js",
    "start:worker": "node dist/worker/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:down": "tsx scripts/migrate.ts down",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint src worker scripts --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/openai": "^0.4.4",
    "axios": "^1.7.9",
    "bullmq": "^5.34.10",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "morgan": "^1.10.0",
    "openai": "^4.82.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.10",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
