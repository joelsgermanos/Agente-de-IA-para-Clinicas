{
  "name": "gestao-operacional",
  "productName": "Gestão Operacional",
  "version": "1.0.0",
  "description": "Sistema de Gestão de Ordens de Serviço para terminal de granéis líquidos — versão web (navegador) e desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "node src/server/server.js",
    "desktop": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win --x64",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@libsql/client": "0.17.4"
  },
  "devDependencies": {
    "electron": "38.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "br.terminal.gestao-operacional",
    "productName": "Gestão Operacional",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Gestão Operacional"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
