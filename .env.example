# ==========================================================
# Ambiente
# ==========================================================
NODE_ENV=development
PORT=3000
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info

# ==========================================================
# PostgreSQL
# ==========================================================
DATABASE_URL=postgres://clinica:clinica@localhost:5432/clinica_ai
PGSSL=false

# ==========================================================
# Redis
# ==========================================================
REDIS_URL=redis://localhost:6379

# ==========================================================
# OpenAI (LLM roteador/agentes + Whisper transcricao)
# ==========================================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o-mini

# ==========================================================
# Evolution API (WhatsApp)
# ==========================================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-global-key
EVOLUTION_INSTANCE_NAME=clinica-principal
# Segredo usado para validar a assinatura/whitelist do webhook recebido
EVOLUTION_WEBHOOK_TOKEN=change-me-webhook-token

# ==========================================================
# Google Calendar
# ==========================================================
# Fluxo OAuth2 (conta do consultorio) - preferido para multiplos profissionais
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2/google/callback
GOOGLE_REFRESH_TOKEN=xxxxxxxxxx
# Alternativa: Service Account com delegacao de dominio (G Suite/Workspace)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_SUBJECT=

# ==========================================================
# Equipe / Transbordo humano
# ==========================================================
# Numero(s) de WhatsApp (com DDI) da secretaria/equipe para receber notificacoes
TEAM_WHATSAPP_NUMBERS=5511999990000,5511988880000
HUMAN_PAUSE_TTL_MINUTES=60

# ==========================================================
# Debounce de mensagens picotadas
# ==========================================================
MESSAGE_DEBOUNCE_MS=4000

# ==========================================================
# Lembretes automaticos (worker cron)
# ==========================================================
REMINDER_CRON_INTERVAL_MS=300000
REMINDER_D1_HOUR=18
REMINDER_SAME_DAY_HOURS_BEFORE=3

# ==========================================================
# Clinica padrao (seed)
# ==========================================================
DEFAULT_CLINIC_NAME="Clinica Exemplo"
DEFAULT_CLINIC_ADDRESS="Rua Exemplo, 123 - Sao Paulo/SP"
